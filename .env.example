DISCORD_TOKEN=your_discord_bot_token_here
# Optional: restrict slash command sync to a single guild for faster updates during dev
DISCORD_GUILD_ID=
# Channel where images are auto-scanned and all collection commands work
DISCORD_SCAN_CHANNEL_ID=
# Channel where /deck commands work (deckbuilder)
DISCORD_DECKBUILDER_CHANNEL_ID=

# --- Debug ---
# Set to 1 to send an ephemeral preview image after each scan showing the isolated card
# and the OCR name zone (red box). Disable in production.
DEBUG_SCAN_PREVIEW=0

# --- Role-based access control (role name or role ID; leave blank = everyone) ---
# Read-only commands (list, search, stats, export, …) — default fallback tier
DISCORD_GUEST_ROLE=
# Required to add/scan cards and create containers
DISCORD_COLLECTOR_ROLE=
# Required to remove cards, delete/rename containers, and manage the hash index
DISCORD_ADMIN_ROLE=
